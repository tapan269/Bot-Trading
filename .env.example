# Alpaca Paper Trading API Credentials
# Get your keys at: https://app.alpaca.markets/paper-trading
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# ── SP500 Strategy (main bot) ──────────────────────────────────────────────
REBALANCE_INTERVAL_SECONDS=7200   # rebalance every 2 hours
TOP_N=20                          # hold top N stocks
SELL_RANK_THRESHOLD=30            # sell if rank drops below this
PORTFOLIO_CASH_BUFFER=0.05        # keep 5% cash

# Signal weights (must sum to 1.0)
SIGNAL_WEIGHT_MA=0.40
SIGNAL_WEIGHT_SENTIMENT=0.30
SIGNAL_WEIGHT_VOLUME=0.30

# Hierarchical scoring
SECTOR_WEIGHT=0.40                # sector score influence on final score

# Sell on hard MA reversal regardless of rank
MA_REVERSAL_THRESHOLD=0.2

# ── Legacy simple-bot settings ─────────────────────────────────────────────
SHORT_MA_PERIOD=9
LONG_MA_PERIOD=21
TRADE_QTY=1
POLL_INTERVAL_SECONDS=60
